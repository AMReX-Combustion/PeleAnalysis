# Generate test plotfile plt_jpdf_B_2d for 2D jpdf averaging test
# Identical fields to plt_jpdf_A_2d; used to verify temporal averaging.

amr.n_cell        = 16 16
amr.max_grid_size = 16
amr.ngrow         = 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 1.0 1.0
geometry.is_periodic = 0 0
plotfile_name = plt_jpdf_B_2d

field.names = var_plane var_sine var_cond

var_plane.type        = plane_step
var_plane.axis        = 0
var_plane.position    = 0.5
var_plane.value_left  = 0.0
var_plane.value_right = 1.0

var_sine.type      = sine
var_sine.frequency = 1.0 0.0
var_sine.phase     = 0.0 0.0
var_sine.amplitude = 0.5
var_sine.offset    = 0.5

var_cond.type        = plane_step
var_cond.axis        = 1
var_cond.position    = 0.5
var_cond.value_left  = 0.0
var_cond.value_right = 1.0
