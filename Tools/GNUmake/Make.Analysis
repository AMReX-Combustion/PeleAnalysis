PELE_ANALYSIS_HOME ?= $(abspath ../..)
PELE_PHYSICS_HOME ?= $(abspath $(lastword $(PELE_ANALYSIS_HOME)/Submodules/PelePhysics))
AMREX_HOME        ?= $(abspath $(lastword $(PELE_PHYSICS_HOME)/Submodules/amrex))
SUNDIALS_HOME     ?= $(abspath $(lastword $(PELE_PHYSICS_HOME)/Submodules/sundials))

BL_NO_FORT = TRUE

TOP := $(PELE_ANALYSIS_HOME)


include $(AMREX_HOME)/Tools/GNUMake/Make.defs


all: $(executable)
	$(SILENT) $(RM) AMReX_buildInfo.cpp
	@echo SUCCESS

#--------------
# AMReX sources
#--------------
Adirs := Base Boundary Extern/amrdata AmrCore LinearSolvers/MLMG

ifeq ($(USE_PARTICLES),TRUE)
  Adirs += Particle
endif

Bpack += $(foreach dir, $(Adirs), $(AMREX_HOME)/Src/$(dir)/Make.package)
Blocs += $(foreach dir, $(Adirs), $(AMREX_HOME)/Src/$(dir))


#--------------------
#PeleAnalysis sources
#--------------------
ifeq ($(USE_UTILS), TRUE)
   Bdirs +=  $(PELE_ANALYSIS_HOME)/Tools/Util/
   Bpack += $(foreach dir, $(Bdirs), $(dir)/Make.package)
   Blocs += $(foreach dir, $(Bdirs), $(dir))
   $(info $${Bpack} is [${Bpack}])
endif
include $(Bpack)

INCLUDE_LOCATIONS += $(Blocs)
VPATH_LOCATIONS   += $(Blocs)


ifeq ($(NEED_DISTANCE),TRUE)
  SDF_LOC = $(PELE_ANALYSIS_HOME)/Tools/SDFGen
  include $(SDF_LOC)/Make.package
  INCLUDE_LOCATIONS += $(SDF_LOC)
  VPATH_LOCATIONS += $(SDF_LOC)
endif

ifeq ($(NEED_QSLIM),TRUE)
  QSLIM_TOOL = $(PELE_ANALYSIS_HOME)/Tools/qslim
  QSLIM_LOC = $(PELE_ANALYSIS_HOME)/Submodules/qslim
  include $(QSLIM_TOOL)/Make.package
  MIX_ROOT       = $(QSLIM_LOC)/mixkit/src
  GFX_ROOT       = $(QSLIM_LOC)/libgfx
  INCLUDE_LOCATIONS += $(QSLIM_TOOL) ${MIX_ROOT} ${GFX_ROOT}/include
  LIBRARY_LOCATIONS += ${MIX_ROOT} ${GFX_ROOT}/src
  LIBRARIES += -lmix -lgfx
  DEFINES += -DHAVE_CONFIG_H -DHAVE_BOOL
  VPATH_LOCATIONS += $(QSLIM_TOOL)
endif

ifeq ($(NEED_PYTORCH),TRUE)
  # 1. ATTEMPT TO FIND SYSTEM PYTORCH FIRST
  # If "import torch" works, reuse that installation's headers and libraries.
  TORCH_CHECK := $(shell python3 -c "import torch; print(torch.__file__)" 2>/dev/null)

  ifneq ($(TORCH_CHECK),)
    # --- OPTION A: USE SYSTEM MODULE / PYTHON ENVIRONMENT ---
    $(info Using PyTorch from system module/Python environment)
    PYTORCH_ROOT := $(shell python3 -c "import torch, os; print(os.path.dirname(torch.__file__))")
    TORCH_LIBPATH = $(PYTORCH_ROOT)/lib
    INCLUDE_LOCATIONS += $(PYTORCH_ROOT)/include $(PYTORCH_ROOT)/include/torch/csrc/api/include
  else
    # --- OPTION B: STANDALONE LIBTORCH (run "make pytorch" once) ---
    $(info PyTorch not importable. Falling back to standalone libtorch in Tools/libtorch)

    PYTORCH_ROOT = $(PELE_ANALYSIS_HOME)/Tools/libtorch
    TORCH_LIBPATH = $(PYTORCH_ROOT)/lib
    INCLUDE_LOCATIONS += $(PYTORCH_ROOT)/include $(PYTORCH_ROOT)/include/torch/csrc/api/include
  endif

  # Architecture-aware download logic for the "make pytorch" target below.
  # Defined unconditionally so "make pytorch" works even when a system torch
  # is importable but you want a standalone libtorch anyway.
  ARCH := $(shell uname -m)
  ifeq ($(USE_CUDA),TRUE)
    PYTORCH_VERSION = cu126
  else
    PYTORCH_VERSION = cpu
  endif

  ifeq ($(ARCH),aarch64)
    ZIPFILE = libtorch-cxx11-abi-shared-with-deps-2.7.0-aarch64+$(PYTORCH_VERSION).zip
  else
    ZIPFILE = libtorch-cxx11-abi-shared-with-deps-2.7.0+$(PYTORCH_VERSION).zip
  endif
  ZIPLINK = $(subst +,%2B,$(ZIPFILE))

  # 2. SHARED LINKING LOGIC (applies to both options above)
  TORCH_LIBS = -ltorch -ltorch_cpu -lc10
  LIBRARY_LOCATIONS += $(TORCH_LIBPATH)
  DEFINES += -D_GLIBCXX_USE_CXX11_ABI=1
  LDFLAGS += -L$(TORCH_LIBPATH) -Wl,--no-as-needed,-rpath=$(TORCH_LIBPATH) $(TORCH_LIBS)
endif

#-------------------
# PelePhysics sources
#-------------------
PPdirs  := Utility/PltFileManager Utility/Filter
Bpack   += $(foreach dir, $(PPdirs), $(PELE_PHYSICS_HOME)/Source/$(dir)/Make.package)
Blocs += $(foreach dir, $(PPdirs), $(PELE_PHYSICS_HOME)/Source/$(dir))


$(info $${Bpack} is [${Bpack}])

include $(Bpack)

INCLUDE_LOCATIONS += $(Blocs)
VPATH_LOCATIONS   += $(Blocs)

CEXE_sources += AMReX_buildInfo.cpp
CEXE_headers += $(AMREX_HOME)/Tools/C_scripts/AMReX_buildInfo.H
INCLUDE_LOCATIONS += $(AMREX_HOME)/Tools/C_scripts


AMReX_buildInfo.cpp:
	$(AMREX_HOME)/Tools/C_scripts/makebuildinfo_C.py \
          --amrex_home "$(AMREX_HOME)" \
          --COMP "$(COMP)" --COMP_VERSION "$(COMP_VERSION)" \
          --GIT "$(TOP) $(AMREX_HOME) $(PELE_PHYSICS_HOME)"

include $(AMREX_HOME)/Tools/GNUMake/Make.rules


clean::
	$(SILENT) $(RM) AMReX_buildInfo.cpp

qslim:
	@echo "==> Building qslim library"
	@cd $(QSLIM_LOC)/libgfx; ./configure
	@cd $(QSLIM_LOC)/libgfx/src; $(MAKE)
	@cd $(QSLIM_LOC)/mixkit; ./configure
	@cd $(QSLIM_LOC)/mixkit/src; $(MAKE)

qslimclean:
	@echo "==> Removing qslim library"
	@cd $(QSLIM_LOC)/libgfx/src; $(MAKE) clean
	@cd $(QSLIM_LOC)/mixkit/src; $(MAKE) clean

pytorch:
	@echo "==> Downloading libtorch ($(ZIPFILE))..."
	@cd $(PELE_ANALYSIS_HOME)/Tools; \
	  wget https://download.pytorch.org/libtorch/$(PYTORCH_VERSION)/$(ZIPLINK); \
	  unzip $(ZIPFILE); rm $(ZIPFILE)

#-----------------------------------------------------------------------------
# for debugging.  To see the value of a Makefile variable,
# e.g. Fmlocs, simply do "make print-Fmlocs".  This will
# print out the value.
#print-%: ; @echo $* is $($*) ; $(SILENT) $(RM) AMReX_buildInfo.cpp
